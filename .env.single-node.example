# Titan single-node deployment — copy to .env and edit for this server.
# Usage: docker compose -f docker-compose.single-node.yml up -d

# --- Role: bootstrap (parent / genesis server) OR joiner (all other servers) ---
TITAN_ROLE=bootstrap

# Joiner only — reachable IP or hostname of the parent node's API (port 9650)
# PARENT_HOST=1.2.3.4

# --- Bootstrap settings (set by role presets below; override for manual bootstrap) ---
TITAN_AUTOCONFIGURE_BOOTSTRAP=0
# TITAN_BOOTSTRAP_ENDPOINT=http://1.2.3.4:9650/ext/info
# BOOTSTRAP_IPS=1.2.3.4:9651
# BOOTSTRAP_IDS=NodeID-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Common ---
TITAN_ORIGIN_URL=https://raw.githubusercontent.com/pakeku/go-titan/main/titan-network/origin.json
TITAN_NODE_IMAGE=ghcr.io/pakeku/go-titan:latest
TITAN_CONTAINER_NAME=titan-node
TITAN_HOSTNAME=titan-node
API_PORT=9650
STAKING_PORT=9651

# Remote servers: set the host's public IP so peers can connect (or AUTOCONFIGURE_PUBLIC_IP=1)
AUTOCONFIGURE_PUBLIC_IP=0
PUBLIC_IP=

# =============================================================================
# Role presets — uncomment ONE block and comment out the other
# =============================================================================

# Parent server (first deploy):
#   TITAN_ROLE=bootstrap
#   TITAN_AUTOCONFIGURE_BOOTSTRAP=0

# Joining server (every additional machine):
#   TITAN_ROLE=joiner
#   PARENT_HOST=1.2.3.4
#   TITAN_AUTOCONFIGURE_BOOTSTRAP=1
#   TITAN_BOOTSTRAP_ENDPOINT=http://1.2.3.4:9650/ext/info